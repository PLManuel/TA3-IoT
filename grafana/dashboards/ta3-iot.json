    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperatura en tiempo real (°C) — líneas: alerta 26 °C / crítico 30 °C",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ta3"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ta3"
          },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dht22\" and r._field == \"temperatura\")\n  |> filter(fn: (r) => contains(value: r.ubicacion, set: ${ubicacion:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"ubicacion\"])"
        }
