      "options": {
        "mode": "markdown",
        "content": "## Monitoreo IoT de Temperatura — Grupo 00\n**Herramientas de Desarrollo Profesional - TIC · UTP** &nbsp;|&nbsp; Flujo: DHT22 (simulado) → EMQX (MQTT) → Telegraf → InfluxDB → Grafana &nbsp;|&nbsp; Lectura cada 10 s"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Temperatura actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ta3"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ta3"
          },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dht22\" and r._field == \"temperatura\")\n  |> filter(fn: (r) => contains(value: r.ubicacion, set: ${ubicacion:json}))\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"ubicacion\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "min": 10,
          "max": 40,
          "displayName": "${__field.labels.ubicacion}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 18
              },
              {
                "color": "orange",
                "value": 26
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
