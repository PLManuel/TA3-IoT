    {
      "id": 8,
      "type": "table",
      "title": "Últimas 20 lecturas",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-ta3"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-ta3"
          },
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dht22\")\n  |> filter(fn: (r) => contains(value: r.ubicacion, set: ${ubicacion:json}))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"ubicacion\", \"sensor\", \"temperatura\", \"humedad\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)"
        }
